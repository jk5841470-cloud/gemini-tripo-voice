# Copy this file to ".env" and fill in the two keys.

# --- Required -------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tripo API key (create one in the Tripo developer platform: https://developers.tripo3d.com/)
TRIPO_API_KEY=

# --- Gemini Live ----------------------------------------------------------
# Model id from the current Live API docs. If your key can't use it, try
# gemini-3.1-flash-live-preview (sync tool calls only).
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck
# How long-running tools talk to Gemini:
#   background -> tool returns instantly, we push a [SYSTEM NOTICE] when done (works on every model, DEFAULT)
#   async      -> NON_BLOCKING tools + FunctionResponse scheduling (only on models that support async tools)
#   blocking   -> classic: Gemini waits silently until the job is done (worst UX, simplest)
TOOL_MODE=background

# --- Tripo ----------------------------------------------------------------
# Global endpoint. (openapi.tripo3d.com is the China-region endpoint.)
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPO_GENERATION_MODEL=v3.1-20260211
TRIPO_SEGMENTATION_MODEL=v2.0-20260430
# simple | balanced | detailed  (v2 segmentation only)
TRIPO_SEGMENTATION_GRANULARITY=balanced
# Textured + PBR = 20 credits. Set TRIPO_TEXTURE=false for ~10 credits (untextured geometry).
TRIPO_TEXTURE=true
TRIPO_PBR=true

# --- Polling / timeouts (seconds) ----------------------------------------
TRIPO_POLL_INTERVAL=3
TRIPO_GENERATION_TIMEOUT=300
TRIPO_SEGMENTATION_TIMEOUT=420

# --- Credit guard ---------------------------------------------------------
# Local safety net: refuse to start a job that would push the tracked monthly spend
# over this number. 0 disables the guard. Free plan = 200.
MONTHLY_CREDIT_BUDGET=200
# Used only for the pre-flight check; real spend is read from Tripo's response.
TRIPO_COST_GENERATION=20
TRIPO_COST_SEGMENTATION=40
